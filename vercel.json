{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "functions": {
    "src/app/api/cron/**": {
      "maxDuration": 60
    },
    "src/app/api/sync/**": {
      "maxDuration": 60
    },
    "src/app/api/reports/export**": {
      "maxDuration": 60
    }
  }
}
