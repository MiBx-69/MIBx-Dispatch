# MiBx-Dispatch ERP — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local
# Never commit .env.local or real secrets to git!

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Upstash Redis (Free at upstash.com) ──────────────────────────────────────
# Sign up at: https://upstash.com → Create Database → Redis → Free tier
# Then: Database Details → REST API → copy URL and token
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxx

# ─── Upstash QStash (Cron Scheduling) ─────────────────────────────────────────
# Used to schedule automated Pathao courier & Shopify sales syncs
# Sign up at: https://console.upstash.com/qstash → API Keys
QSTASH_CURRENT_SIGNING_KEY=sig_xxxxxxxxxxxxxxxxxxxxxxxx
QSTASH_NEXT_SIGNING_KEY=sig_xxxxxxxxxxxxxxxxxxxxxxxx
# Fallback secret for manual / automated cron triggering
CRON_SECRET=your_long_random_cron_secret_32_chars_min

# ─── Shopify Custom App ────────────────────────────────────────────────────────
# Setup: Shopify Admin → Settings → Apps → Develop apps → Create app
SHOPIFY_SHOP_DOMAIN=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here
SHOPIFY_API_VERSION=2024-07

# ─── Pathao Courier API ───────────────────────────────────────────────────────
# From: Pathao Merchant Dashboard → API Credentials
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_username
PATHAO_PASSWORD=your_pathao_password
PATHAO_WEBHOOK_SECRET=your_pathao_webhook_secret_here

# ─── SMTP Email Notifications ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# ─── App Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
APP_SECRET=change_this_to_a_long_random_string_32_chars_min
NEXT_PUBLIC_APP_NAME=MiBx Dispatch

# ─── Optional: Fraud Detection ────────────────────────────────────────────────
# From: fraudspy.com
FRAUDSPY_API_KEY=

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
