# MiBx-Dispatch ERP — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local in the client/ directory
# Never commit .env.local to git!

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Upstash Redis (Free at upstash.com) ──────────────────────────────────────
# Sign up at: https://upstash.com → Create Database → Redis → Free tier
# Then: Database Details → REST API → copy URL and token
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxx

# ─── Upstash QStash (Vercel Cron Alternative — Free) ──────────────────────────
# Used to schedule automated Pathao courier status syncs without Vercel cron.
# Sign up at: https://console.upstash.com/qstash → API Keys → copy keys below.
# Schedule your endpoint: POST https://your-app.vercel.app/api/cron/courier-sync
# Recommended cron expression: 0 * * * * (every hour)
QSTASH_CURRENT_SIGNING_KEY=sig_xxxxxxxxxxxxxxxxxxxxxxxx
QSTASH_NEXT_SIGNING_KEY=sig_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional fallback secret for manual/dev triggering (used if QStash keys not set):
# CRON_SECRET=your_manual_cron_secret_here

# ─── Shopify Custom App ────────────────────────────────────────────────────────
# Setup: Shopify Admin → Settings → Apps → Develop apps → Create app
# Then: API credentials → Install app → copy Admin API access token
SHOPIFY_SHOP_DOMAIN=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here
SHOPIFY_API_VERSION=2026-07

# ─── Pathao Merchant API ──────────────────────────────────────────────────────
# From: Pathao Merchant Dashboard → API Credentials
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=

# ─── App Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change_this_to_a_long_random_string_32_chars_min
NEXT_PUBLIC_APP_NAME=MiBx Dispatch

# ─── Optional: Fraud Detection ────────────────────────────────────────────────
# Get from: fraudspy.com (stub if no key)
FRAUDSPY_API_KEY=

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
